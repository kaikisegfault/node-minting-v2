# ============================================
# EXPL Node Minting V2 - Environment Variables
# ============================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# ----- DEPLOYER / SIGNER -----
# This is the wallet that deployed Node contracts on ETH & Flare.
DEPLOYER_PRIVATE_KEY=

# Private key of the signer wallet used by Lambda to sign mint authorizations.
SIGNER_PRIVATE_KEY=

# ----- RPC ENDPOINTS -----

# Alchemy API key — used for Ethereum mainnet & Sepolia RPC access.
ALCHEMY_API_KEY=

# Mainnet RPCs
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}
FLARE_RPC_URL=https://flare-api.flare.network/ext/bc/C/rpc
BSC_RPC_URL=https://bsc-dataseed.binance.org/

# Testnet RPCs
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/${ALCHEMY_API_KEY}
FLARE_TESTNET_RPC_URL=https://coston2-api.flare.network/ext/bc/C/rpc
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545

# ----- CONTRACT ADDRESSES -----

# Mainnet — same address on ETH, Flare, and BSC (deployed at nonce 0, 1, 2 from deployer wallet)
NODE_CONTRACT_ADDRESS=0x468F1F91fc674e0161533363B13c2ccBE3769981
NODE_ESCROW_ADDRESS=0x9eAEc5DB08E0D243d07A82b8DD54Cc70E745f8b4
BRIDGE_ESCROW_ADDRESS=0x129D9dce2326492d073D147762230e60c01e0f97

# Testnets — fill after deploying to Sepolia/Coston2/BSC Testnet
TESTNET_NODE_CONTRACT_ADDRESS=
TESTNET_NODE_ESCROW_ADDRESS=
TESTNET_BRIDGE_ESCROW_ADDRESS=

# ----- BLOCK EXPLORER API KEYS (for contract verification after deployment) -----

# https://etherscan.io/myapikey
ETHERSCAN_API_KEY=

# https://bscscan.com/myapikey — needed to verify BSC contracts
BSCSCAN_API_KEY=

# Flare uses Blockscout — no API key needed for basic calls.
# Only needed if Blockscout requires auth for verification.
FLARE_EXPLORER_API_KEY=

# ----- LAMBDA / API -----

# Production API Gateway endpoint for NodeMintQueue Lambda
API_GATEWAY_URL=https://are21gn8z7.execute-api.us-east-1.amazonaws.com/v1

# Port for local Lambda dev server (local-server.mjs)
LAMBDA_LOCAL_PORT=3001

AWS_REGION=us-east-1
DYNAMODB_TABLE_NAME=NodeMintQueue

# ----- PRICE FEEDS -----

# CoinMarketCap API key — fallback price source when Flare FTSO is unavailable.
# https://pro.coinmarketcap.com/account
CMC_API_KEY=

# Flare FTSO (Flare Time Series Oracle) contract for live ETH/FLR prices.
# This is a public Flare contract, not an API key.
FLARE_PRICE_FEED_CONTRACT=0xB18d3A5e5A85C65cE47f977D7F486B79F99D3d32

# ----- DAPP -----

# Same as NODE_CONTRACT_ADDRESS — used by React DApp (REACT_APP_ prefix required by CRA)
REACT_APP_NODE_CONTRACT_ADDRESS=0x468F1F91fc674e0161533363B13c2ccBE3769981

# Alchemy key for DApp's Ethereum provider
REACT_APP_ALCHEMY_API_KEY=

# Infura key — used as backup/alternative ETH provider in DApp
REACT_APP_INFURA_API_KEY=

# Flare WebSocket — used by DApp for real-time event listening on Flare
REACT_APP_FLARE_WEBSOCKET=wss://flare-api.flare.network/ext/bc/C/ws

# API endpoint DApp calls for mint queue + signature generation
REACT_APP_API_ENDPOINT=https://are21gn8z7.execute-api.us-east-1.amazonaws.com/v1
